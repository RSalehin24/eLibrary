{
  "name": "bengali-library-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "postbuild": "node scripts/package-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test ../../tests/web/unit/*.test.mjs",
    "generate:api": "openapi-typescript ../../docs/api/openapi.json -o src/api/vendor/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3"
  }
}
