{
  "openapi": "3.1.0",
  "info": {
    "title": "eLibrary shared HTTP types",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine code from the error catalog."
          },
          "details": {},
          "message": {
            "type": "string",
            "description": "Safe to display: never secrets, SQL, stack traces or internal ids."
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "The one error shape on every route: `{ \"error\": { code, message, request_id, details? } }`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "Scope": {
        "type": "string",
        "description": "The scope a route declares; every route declares exactly one.",
        "enum": [
          "public",
          "browse",
          "preview",
          "read",
          "read_once",
          "download",
          "kindle",
          "operate",
          "manage_catalog",
          "manage_users",
          "session"
        ]
      }
    }
  }
}
