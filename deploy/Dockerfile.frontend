ARG NODE_IMAGE=node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
FROM ${NODE_IMAGE} AS build
WORKDIR /app/web
COPY app/web/package.json app/web/package-lock.json ./
RUN npm ci
COPY app/web ./
ARG PUBLIC_SITE_URL
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL} API_INTERNAL_URL=http://api:8000
RUN npm run build

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build /app/web/.next/standalone ./
COPY deploy/publish-static-assets.mjs /app/publish-static-assets.mjs
RUN mkdir -p /data/next-static && chown node:node /data/next-static
USER node
CMD ["node", "server.js"]
