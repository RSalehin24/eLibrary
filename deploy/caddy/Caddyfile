# HTTPS and certificate handling only; no business logic. Forwards `/` to web and `/api/*`
# to the gateway, nothing else. `/internal/*` never leaves the Compose network.
{
	admin off
	auto_https disable_redirects
}

# why: an unprivileged port inside the container; the host maps it to 443 in production.
localhost:8443 {
	tls internal
	encode zstd gzip

	handle /internal/* {
		respond "not found" 404
	}

	handle /api/* {
		reverse_proxy gateway:8080
	}

	handle {
		reverse_proxy web:4000
	}
}
