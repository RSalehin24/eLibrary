{
  "permissions": {
    "allow": [
      "Bash(python3 planning/tools/check_plan.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./deploy/env/**)",
      "Read(./local/env/**)",
      "Read(./local-production/env/**)",
      "Read(./logs/**)",
      "Edit(./app/**)",
      "Write(./app/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/check-plan.sh" }
        ]
      }
    ]
  }
}
